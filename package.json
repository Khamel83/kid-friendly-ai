{
  "name": "kid-friendly-ai",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "type-check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "e2e": "playwright test",
    "e2e:ci": "playwright test --headed",
    "e2e:ui": "playwright test --ui",
    "audit": "lighthouse http://localhost:3000 --output html --output-path ./reports/lighthouse.html",
    "bundle-analyzer": "ANALYZE=true npm run build",
    "security-audit": "npm audit --audit-level moderate",
    "export": "next build && next export",
    "clean": "rm -rf .next out node_modules/.cache"
  },
  "dependencies": {
    "next": "16.4.6",
    "openai": "^7.64.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@babel/core": "^8.1.3",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.7",
    "@reduxjs/toolkit": "^2.15.0",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/next": "^9.0.0",
    "@types/node": "^26.6.10",
    "@types/react": "^19.3.2",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.15.0",
    "eslint-config-next": "16.4.6",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "react-redux": "^9.3.1",
    "typescript": "^7.0.2"
  }
}
